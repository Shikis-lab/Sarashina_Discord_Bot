# Discord Bot Token
# https://discord.com/developers/applications
# ※「Privileged Gateway Intents」の「MESSAGE CONTENT INTENT」を有効化してください。
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Sarashina API Key
# https://chat.sarashina.ai/dashboard/api-keys
SARASHINA_API_KEY=your_sarashina_api_key_here

# モデル名 (sarashina3-mini または sarashina3-nano)
SARASHINA_MODEL=sarashina3-mini

# システムプロンプト（省略可）
# SARASHINA_SYSTEM_PROMPT=あなたは親切で丁寧なアシスタントです。

# 連携対象のDiscordチャンネルID（省略時は 0 = 全チャンネルでのメンションに反応）
# 特定のチャンネルを設定した場合、そのチャンネルでの通常発言＋他チャンネルでのメンションに反応します。
ALLOWED_CHANNEL_ID=0
